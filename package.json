{
  "name": "react-router-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "if [ \"$SKIP_PREPARE\" != \"1\" ]; then husky; fi",
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "docker:build": "docker compose build --no-cache",
    "docker:start": "docker compose up -d",
    "docker:stop": "docker compose down",
    "typegen": "react-router typegen",
    "typecheck": "react-router typegen && tsc",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@fontsource/source-sans-pro": "^5.3.0",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "dotenv": "^18.0.5",
    "fs-extra": "^11.4.1",
    "handlebars": "^4.7.8",
    "isbot": "^5.2.2",
    "nodemailer": "^10.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "remix-utils": "^10.0.0",
    "sanitize-html": "^2.18.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "husky": "^9.1.7",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=24"
  },
  "eslintIgnore": [
    "/node_modules",
    "/build"
  ],
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "fsevents": false
  }
}
